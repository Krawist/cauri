<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android forgets the geofences of the places at a restart: PlaceBootReceiver has them registered again. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Lets PermissionServiceImpl check that this phone has the screen of Cauri's listener alone (Android 11+). -->
    <queries>
        <intent>
            <action android:name="android.settings.NOTIFICATION_LISTENER_DETAIL_SETTINGS" />
        </intent>
    </queries>

    <application>
        <!-- Reads the notifications of MoMo, Orange Money, the banks and the SMS app; never READ_SMS / RECEIVE_SMS. -->
        <service
            android:name=".CauriNotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Receives the stays at the places and their departures (geofences), sent by Google Play services only. -->
        <receiver
            android:name=".place.PlaceTransitionReceiver"
            android:exported="false" />
        <!-- The buttons of the reminder notifications, answered without opening the app. -->
        <receiver
            android:name=".reminder.ReminderReplyReceiver"
            android:exported="false" />
        <receiver
            android:name=".place.PlaceBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

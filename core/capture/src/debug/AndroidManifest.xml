<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Debug builds only: keeps and reads a made-up operator message, to check the templates on a phone.
             adb shell am broadcast -a com.cauri.debug.RECORD_SIGNAL -e title OrangeMoney -e text "…" -p com.cauri.debug -->
        <receiver
            android:name=".signal.DebugSignalReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.cauri.debug.RECORD_SIGNAL" />
            </intent-filter>
        </receiver>
        <!-- Debug builds only: shows the warning that the capture stopped, without a month of silence.
             adb shell am broadcast -a com.cauri.debug.SHOW_CAPTURE_WARNING -p com.cauri.debug -->
        <receiver
            android:name=".health.DebugCaptureWarningReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.cauri.debug.SHOW_CAPTURE_WARNING" />
            </intent-filter>
        </receiver>
        <!-- Debug builds only: simulates a month without message, so that Accueil shows its card when it opens again;
             the boolean extra on false ends it.
             adb shell am broadcast -a com.cauri.debug.SIMULATE_CAPTURE_SILENCE -p com.cauri.debug -->
        <receiver
            android:name=".health.DebugCaptureSilenceReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.cauri.debug.SIMULATE_CAPTURE_SILENCE" />
            </intent-filter>
        </receiver>
        <!-- Debug builds only: tells a stay at a place, or with the boolean left true its departure, as its geofence would.
             adb shell am broadcast -a com.cauri.debug.PLACE_VISIT -e place 3 -p com.cauri.debug -->
        <receiver
            android:name=".place.DebugPlaceTransitionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.cauri.debug.PLACE_VISIT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

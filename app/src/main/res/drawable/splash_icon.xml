    <path
        android:fillColor="#85FFFFFF"
        android:pathData="M122,96 h44 a26,26 0 0,1 26,26 v44 a26,26 0 0,1 -26,26 h-44 a26,26 0 0,1 -26,-26 v-44 a26,26 0 0,1 26,-26 Z"
        android:strokeWidth="1"
        android:strokeColor="#CCFFFFFF" />
    <group
        android:scaleX="0.62"
        android:scaleY="0.62"
        android:translateX="113"
        android:translateY="113">
        <path android:pathData="M4,50 A46,46 0 1,0 96,50 A46,46 0 1,0 4,50 Z">
            <aapt:attr name="android:fillColor">

                    android:endColor="#B07E2A"
                    android:endX="77.6"
                    android:endY="96"
                    android:startColor="#EBC77F"
                    android:startX="22.4"
                    android:startY="4"
                    android:type="linear" />
            </aapt:attr>
        </path>
        <path
            android:pathData="M11.5,50 A38.5,38.5 0 1,0 88.5,50 A38.5,38.5 0 1,0 11.5,50 Z"

            android:strokeColor="#99FFFFFF"
            android:strokeLineCap="round" />
        <path
            android:pathData="M50,22 C44,36 44,64 50,78"
            android:strokeWidth="4.6"
            android:strokeColor="#5E4212"
            android:strokeLineCap="round" />
